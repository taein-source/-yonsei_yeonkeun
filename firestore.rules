rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating fields and data integrity
    function isValidItem(data) {
      return data.name is string && data.name.size() > 0 &&
             data.location is string &&
             data.price is string &&
             data.status in ['나눔중', '예약중', '완료', '무료'] &&
             data.seller is string;
    }

    function isValidChatRoom(data) {
      return data.id is string &&
             data.participants is list &&
             data.participantUsernames is list &&
             data.updatedAt is number;
    }

    function isValidChatMessage(data) {
      return data.id is string &&
             data.senderUsername is string && data.senderUsername.size() > 0 &&
             data.senderName is string &&
             data.createdAt is number;
    }

    // 1. Items & Products collection (Public read & community write)
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isValidItem(request.resource.data);
      allow delete: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidItem(request.resource.data);
      allow delete: if true;
    }

    // 2. Chats collection & nested messages and logs
    match /chats/{chatRoomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /logs/{logId} {
        allow read, write: if true;
      }
    }

    // 3. Users collection (Authentication & profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 4. Fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
